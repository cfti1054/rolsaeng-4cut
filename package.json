{
  "name": "rolsaeng-4cut",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:validate": "pnpm --filter api prisma:validate",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.32",
      "multer@<2.5.0": "2.5.0",
      "deepmerge-ts@<8.0.0": "8.0.2"
    }
  }
}
