# =========================================================
# 게임 커뮤니티 대시보드 환경 변수 예시
# 복사: apps/api/.env (API), apps/web/.env.local (웹: WEB_ 아래 항목만)
# 값이 비어 있는 비밀값은 반드시 채워야 서버가 시작된다.
# =========================================================

# ---------- 공통 ----------
NODE_ENV=development

# ---------- API 서버 (apps/api) ----------
API_PORT=4000
# 브라우저가 보는 웹 주소. OAuth 콜백 후 리다이렉트, 쿠키 판단 기준
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (docker-compose.yml 기본값). 테스트는 별도 스키마 사용: ?schema=test
DATABASE_URL=postgresql://gcd:gcd@localhost:5432/gcd?schema=public
# Redis는 선택(S1부터). 있으면 동기화 작업을 BullMQ 큐로, 비어 있으면 프로세스 내 큐 + DB 상태로 처리한다
REDIS_URL=
# docker compose의 redis를 쓸 때: REDIS_URL=redis://localhost:6379

# ---------- 인증: JWT / 쿠키 ----------
# 액세스 토큰 서명 키(HS256). 32바이트 이상 무작위 문자열
JWT_ACCESS_SECRET=
# 액세스 토큰 수명(초). 기본 900 = 15분
JWT_ACCESS_TTL_SEC=900
# 리프레시 토큰 수명(일). 기본 30
REFRESH_TOKEN_TTL_DAYS=30
# OAuth state 쿠키 서명 키. 32바이트 이상 무작위 문자열
COOKIE_SECRET=

# ---------- 디스코드 OAuth2 ----------
# https://discord.com/developers/applications 에서 발급
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 디스코드 앱에 등록할 리다이렉트 URI. 웹 오리진의 /api/v1 프록시 경로를 쓴다
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback
# 커뮤니티 디스코드 서버 ID. 비어 있으면 서버 멤버 검사를 하지 않는다
DISCORD_GUILD_ID=
# 로그인 시 운영진(admin)으로 승격할 디스코드 ID 목록(쉼표 구분). 승격만 하고 강등하지 않는다
ADMIN_DISCORD_IDS=

# ---------- 개발 전용 ----------
# true일 때만 POST /api/v1/auth/dev-login 이 열린다. NODE_ENV=production이면 값과 무관하게 닫힌다
AUTH_DEV_LOGIN=false

# ---------- 외부 API: 게임 계정 연동·동기화 (S1) ----------
# 라이엇 개발 키는 24시간마다 만료된다. 비어 있으면 라이엇 연동은 GAME_PROVIDER_NOT_CONFIGURED(503)
RIOT_API_KEY=
# https://steamcommunity.com/dev/apikey 에서 발급. 비어 있으면 스팀 연동은 GAME_PROVIDER_NOT_CONFIGURED(503)
STEAM_API_KEY=
# 라이엇 라우팅(문서 9장): 계정·매치 = 지역(asia), 티어·소환사 = 플랫폼(kr)
RIOT_REGIONAL_ROUTING=asia
RIOT_PLATFORM_ROUTING=kr
# 라이엇 호출 한도(호스트별 토큰 버킷 2개). 기본값 = 개발 키 수준. production 키를 받으면 올린다
RIOT_RATE_LIMIT_PER_SEC=20
RIOT_RATE_LIMIT_PER_2MIN=100
# 외부 API 요청 1건 타임아웃(ms)
EXTERNAL_API_TIMEOUT_MS=5000
# 라이엇 소유 확인 제한 시간(초). 기본 600 = 10분
RIOT_VERIFICATION_TTL_SEC=600
# 사용자당 라이엇 ID 최대 개수(대표 1 + 부계정). 스팀은 1개 고정
RIOT_ACCOUNTS_MAX=3
# Data Dragon 버전(아이콘·챔피언 이미지/한국어 이름). 비어 있으면 versions.json 최신값을 하루 1회 조회
RIOT_DDRAGON_VERSION=
# 수동 새로고침 하루 횟수(사용자당, 라이엇·스팀 합산, KST 자정 초기화). 문서 9장 제안값 5
SYNC_DAILY_LIMIT=5
# cron 생산자(티어 1시간, 스팀 새벽 5시 KST, 멈춘 작업 정리)만 이 프로세스에서 켤지. false 여도 큐 소비자(수동 새로고침 처리)는 항상 동작(D69). 테스트·로컬에서 끄려면 false
SYNC_JOBS_ENABLED=true

# ---------- 웹 (apps/web) ----------
# Next.js 서버가 /api/v1/* 요청을 프록시할 API 서버 주소(브라우저에는 노출되지 않음)
API_ORIGIN=http://localhost:4000
# 로그인 화면에 개발 전용 로그인 폼을 보일지(표시만 제어, 실제 허용은 API의 AUTH_DEV_LOGIN이 결정)
NEXT_PUBLIC_AUTH_DEV_LOGIN=false
# 웹을 백엔드 없이 목 API로 실행(빌드 시점에 코드에 박힘, 바꾸면 다시 빌드)
NEXT_PUBLIC_API_MOCK=false
# 목 모드에서 액세스 토큰 만료(초). 짧게 하면 refresh 재시도 흐름을 볼 수 있음
NEXT_PUBLIC_API_MOCK_ACCESS_TTL_SEC=900
